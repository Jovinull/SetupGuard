# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# extension bundle and package: both are produced by `pnpm --filter setupguard
# run package` and neither belongs in the history
packages/vscode/out/
*.vsix

# test / tooling caches
coverage/
.vitest/
.eslintcache

# editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp

# local environment
.env
.env.local
.env.*.local

# ...but fixtures are part of the test suite and must stay versioned
!fixtures/**/.env
!fixtures/**/.env.local
