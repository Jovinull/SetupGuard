{
  "name": "setupguard-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SetupGuard — repository development readiness diagnostics (monorepo root).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "doctor": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.11"
  }
}
