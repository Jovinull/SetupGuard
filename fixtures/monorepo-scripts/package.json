{
  "name": "monorepo-scripts",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:api": "pnpm --filter api run build",
    "build:web": "npm --prefix ./packages/web run build",
    "build:all": "pnpm -r build",
    "check": "pnpm run build:api && pnpm run build:web"
  }
}
