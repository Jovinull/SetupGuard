  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@setupguard/adapter-node": "workspace:*",
    "@setupguard/core": "workspace:*"
  }
}
