{
  "name": "@setupguard/cli",
  "version": "0.1.0",
  "private": true,
  "description": "SetupGuard command line interface.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "setupguard": "./dist/bin.js"
  },
