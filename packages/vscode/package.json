{
  "name": "@setupguard/vscode",
  "version": "0.1.0",
  "private": true,
  "description": "Presentation layer that maps SetupGuard reports onto editor diagnostics. The extension host wiring is not part of v0.1.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@setupguard/core": "workspace:*"
  },
  "devDependencies": {
    "@setupguard/adapter-node": "workspace:*"
  }
}
